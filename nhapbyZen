local filtered = {}

local function computeFiltered()
    local term = string.lower(searchBox.Text)
    filtered = {}
    for _, pack in ipairs(packsList) do
        if (activeTab == "anims") or favorites[tostring(pack.id)] then
            if term == "" or string.find(string.lower(pack.name), term, 1, true) then
                filtered[#filtered + 1] = pack
            end
        end
    end
    table.sort(filtered, function(a, b) return a.name < b.name end)
    local total = math.max(1, math.ceil(#filtered / CONFIG.perPage))
    currentPage = math.clamp(currentPage, 1, total)
end

