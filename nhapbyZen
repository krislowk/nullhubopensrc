local currentPackId = nil
local animatorConn = nil
local loadedTracks = {}
local currentCat = nil

local function resolveCategory(str)
    if not str then return nil end
    str = string.lower(tostring(str))
    if str:find("swimidle") then return "swimidle" end
    if str:find("idle") then return "idle" end
    if str:find("walk") then return "walk" end
    if str:find("run") then return "run" end
    if str:find("jump") then return "jump" end
    if str:find("fall") then return "fall" end
    if str:find("climb") then return "climb" end
    if str:find("swim") then return "swim" end
    return nil
end

local function getMappingsFromAsset(assetId)
    local mappings = {}
    local ok, objs = pcall(function() return game:GetObjects("rbxassetid://" .. tostring(assetId):gsub("rbxassetid://", "")) end)
    if ok and type(objs) == "table" then
        for _, obj in ipairs(objs) do
            local function walk(parent, path)
                for _, child in ipairs(parent:GetChildren()) do
                    if child:IsA("Animation") then
                        local parts = (path .. "." .. child.Name):split(".")
                        local cat = resolveCategory(parts[#parts - 1]) or "idle"
                        table.insert(mappings, { cat = cat, id = child.AnimationId })
                    elseif #child:GetChildren() > 0 then
                        walk(child, path .. "." .. child.Name)
                    end
                end
            end
            walk(obj, obj.Name)
            obj:Destroy()
        end
    end
    return mappings
end

local function stopCustomAnimator()
    if animatorConn then
        animatorConn:Disconnect()
        animatorConn = nil
    end
    for _, tracks in pairs(loadedTracks) do
        for _, track in ipairs(tracks) do
            pcall(function() track:Stop(0) end)
        end
    end
    loadedTracks = {}
    currentCat = nil
end

local function startCustomAnimator(hum, animate, mappings)
    stopCustomAnimator()
    if animate then animate.Disabled = true end

    local animator = hum:FindFirstChildOfClass("Animator") or Instance.new("Animator", hum)
    
    for _, m in ipairs(mappings) do
        local c = m.cat
        if not loadedTracks[c] then loadedTracks[c] = {} end
        
        local anim = Instance.new("Animation")
        anim.AnimationId = m.id
        local track = animator:LoadAnimation(anim)
        track.Priority = Enum.AnimationPriority.Movement
        track.Looped = (c ~= "jump")
        table.insert(loadedTracks[c], track)
    end
    
    animatorConn = RunService.Heartbeat:Connect(function()
        if not hum or not hum.Parent then return end
        
        local state = hum:GetState()
        local moving = hum.MoveDirection.Magnitude > 0.1
        local target = "idle"
        
        if state == Enum.HumanoidStateType.Freefall then
            target = "fall"
        elseif state == Enum.HumanoidStateType.Jumping then
            target = "jump"
        elseif state == Enum.HumanoidStateType.Swimming then
            target = moving and "swim" or "swimidle"
        elseif state == Enum.HumanoidStateType.Climbing then
            target = "climb"
        elseif moving then
            target = hum.WalkSpeed > 16 and "run" or "walk"
        end
        
        if target ~= currentCat then
            currentCat = target
            for _, tracks in pairs(loadedTracks) do
                for _, t in ipairs(tracks) do
                    if t.IsPlaying then t:Stop(0.2) end
                end
            end
            if loadedTracks[target] then
                for _, t in ipairs(loadedTracks[target]) do
                    t:Play(0.2)
                end
            end
        end
    end)
end

local function applyPack(pack)
    local char = LocalPlayer.Character
    if not char then return false, "no character" end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local animate = char:FindFirstChild("Animate")
    if not hum then return false, "no humanoid" end

    local mappings = {}
    for _, ids in pairs(pack.bundledItems) do
        local idList = type(ids) == "table" and ids or {ids}
        for _, id in ipairs(idList) do
            local found = getMappingsFromAsset(id)
            for _, f in ipairs(found) do table.insert(mappings, f) end
        end
    end

    if #mappings == 0 then
        for cat, ids in pairs(pack.bundledItems) do
            local c = resolveCategory(cat)
            if c then
                local idList = type(ids) == "table" and ids or {ids}
                for _, id in ipairs(idList) do
                    table.insert(mappings, { cat = c, id = "rbxassetid://" .. tostring(id):gsub("rbxassetid://", "") })
                end
            end
        end
    end

    if #mappings == 0 then return false, "no data" end

    startCustomAnimator(hum, animate, mappings)
    currentPackId = pack.id
    return true
end

local function restoreDefault()
    stopCustomAnimator()
    local char = LocalPlayer.Character
    local animate = char and char:FindFirstChild("Animate")
    if animate then animate.Disabled = false end
    currentPackId = nil
    return true
end

