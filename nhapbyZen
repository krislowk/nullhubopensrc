local function make(class, props, parent)
    local inst = Instance.new(class)
    for k, v in pairs(props or {}) do inst[k] = v end
    if parent then inst.Parent = parent end
    return inst
end
local function round(inst, r)
    local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, r or 8); c.Parent = inst; return c
end
local function stroke(inst, color, thickness)
    local s = Instance.new("UIStroke"); s.Color = color; s.Thickness = thickness or 1; s.Transparency = 0.5; s.Parent = inst; return s
end

local PATH_LIST = "nullhub_anim_list.json"
local PATH_FAVS = "nullhub_anim_favs.json"

local function readJson(path)
    if not (isfile and isfile(path)) then return nil end
    local ok, data = pcall(readfile, path)
    if not ok or not data then return nil end
    local ok2, d = pcall(function() return HttpService:JSONDecode(data) end)
    return ok2 and d or nil
end
local function writeJson(path, tbl)
    if not writefile then return end
    pcall(writefile, path, HttpService:JSONEncode(tbl))
end

local packsList, packsById, favorites = {}, {}, {}

local function loadFavorites()
    local d = readJson(PATH_FAVS)
    if type(d) == "table" then
        for _, id in ipairs(d) do favorites[tostring(id)] = true end
    end
end
local function saveFavorites()
    local list = {}
    for id in pairs(favorites) do list[#list + 1] = id end
    writeJson(PATH_FAVS, list)
end

local function httpGet(url)
    local req = http_request or request or syn and syn.request
    if req then
        local ok, res = pcall(function() return req({Url = url, Method = "GET"}) end)
        if ok and res and res.StatusCode == 200 and res.Body then return res.Body end
    end
    local ok, body = pcall(function() return game:HttpGet(url) end)
    if ok and type(body) == "string" and #body > 4 then return body end
    return nil
end

local function fetchSniperList()
    local out, seen = {}, {}
    for _, url in ipairs({ CONFIG.url_sale, CONFIG.url_offsale }) do
        local body = httpGet(url)
        if body then
            local ok, decoded = pcall(function() return HttpService:JSONDecode(body) end)
            if ok and type(decoded) == "table" then
                local arr = decoded.data or decoded
                if type(arr) == "table" then
                    for _, item in pairs(arr) do
                        local id = tonumber(item.id)
                        local bundled = item.bundledItems
                        if id and id > 0 and type(bundled) == "table" and next(bundled) ~= nil and not seen[id] then
                            seen[id] = true
                            out[#out + 1] = {
                                id = id,
                                name = tostring(item.name or ""),
                                bundledItems = bundled,
                            }
                        end
                    end
                end
            end
        end
        task.wait(0.1)
    end
    return out
end

local function addPack(entry)
    if not entry or not entry.id or packsById[entry.id] then return end
    if type(entry.bundledItems) ~= "table" then return end
    
    local name = tostring(entry.name)
    local cleanName = string.gsub(name, "%s+", "")
    if #cleanName < 2 or string.match(cleanName, "^[%.%-_]+$") then
        cleanName = "Pack " .. tostring(entry.id)
    else
        cleanName = name
    end

    packsById[entry.id] = {
        id = entry.id,
        name = cleanName,
        bundledItems = entry.bundledItems,
    }
    packsList[#packsList + 1] = packsById[entry.id]
end

