    end

    tabAnims.BackgroundColor3 = (activeTab == "anims") and COL.active or COL.card
    tabAnims.TextColor3 = (activeTab == "anims") and COL.text or COL.muted
    tabFavs.BackgroundColor3 = (activeTab == "favs") and COL.active or COL.card
    tabFavs.TextColor3 = (activeTab == "favs") and COL.text or COL.muted

    computeFiltered()

    local total = math.max(1, math.ceil(#filtered / CONFIG.perPage))
    pageLabel.Text = currentPage .. " / " .. total

    local startIdx = (currentPage - 1) * CONFIG.perPage
    for i = 1, CONFIG.perPage do
        local pack = filtered[startIdx + i]
        if pack then buildCard(pack, i) end
    end

    if #packsList == 0 then
        emptyLabel.Text = "Fetching packs..."
        emptyLabel.Visible = true
    elseif #filtered == 0 then
        emptyLabel.Text = (activeTab == "favs") and "No favorites yet." or "No packs found."
        emptyLabel.Visible = true
    else
        emptyLabel.Visible = false
    end
end

prevBtn.MouseButton1Click:Connect(function()
    local total = math.max(1, math.ceil(#filtered / CONFIG.perPage))
    if currentPage > 1 then currentPage = currentPage - 1; renderPage(false) end
end)
nextBtn.MouseButton1Click:Connect(function()
    local total = math.max(1, math.ceil(#filtered / CONFIG.perPage))
    if currentPage < total then currentPage = currentPage + 1; renderPage(false) end
end)
tabAnims.MouseButton1Click:Connect(function() activeTab = "anims"; currentPage = 1; renderPage(false) end)
tabFavs.MouseButton1Click:Connect(function() activeTab = "favs"; currentPage = 1; renderPage(false) end)
searchBox:GetPropertyChangedSignal("Text"):Connect(function() currentPage = 1; renderPage(true) end)

restoreBtn.MouseButton1Click:Connect(function()
    restoreDefault()
    renderPage(true)
end)

local function hover(btn)
    btn.MouseEnter:Connect(function() TweenService:Create(btn, T_FAST, { BackgroundColor3 = COL.hover }):Play() end)
    btn.MouseLeave:Connect(function() TweenService:Create(btn, T_FAST, { BackgroundColor3 = COL.card }):Play() end)
end
hover(restoreBtn); hover(prevBtn); hover(nextBtn); hover(closeBtn); hover(floatBtn)

local function onCharacter(char)
    if currentPackId and packsById[currentPackId] then
        task.wait(0.5)
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then applyPack(packsById[currentPackId]) end
    end
end
LocalPlayer.CharacterAdded:Connect(onCharacter)

-- ============================== Boot ==============================

loadFavorites()

local cachedList = readJson(PATH_LIST)
if type(cachedList) == "table" and #cachedList > 0 then
    for _, entry in ipairs(cachedList) do addPack(entry) end
    renderPage(true)
else
    renderPage(true)
end

task.spawn(function()
    local sniper = fetchSniperList()
    if #sniper == 0 then
        return
    end
    
    for _, entry in ipairs(sniper) do
        if not packsById[entry.id] then addPack(entry) end
    end
    local persist = {}
    for _, p in ipairs(packsList) do persist[#persist + 1] = { id = p.id, name = p.name, bundledItems = p.bundledItems } end
    writeJson(PATH_LIST, persist)
    
    renderPage(true)
end)
