local function joinServer(jobId, isHop, serverList, index)
    if isTeleporting then return end
    isTeleporting = true
    
    local success, err = pcall(function()
        TeleportService:TeleportToPlaceInstance(PLACE_ID, jobId, LocalPlayer)
    end)
    
    if not success then
        isTeleporting = false
        if not isHop then
            showToast("Server full. Refreshing...")
            refresh(false)
        else
            if serverList and index and index < #serverList then
                task.wait(0.5)
                joinServer(serverList[index + 1].id, isHop, serverList, index + 1)
            else
                showToast("All servers full.")
            end
        end
    end
end

