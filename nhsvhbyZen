local function setupAutoReexecute()
    if SCRIPT_URL == "YOUR_SCRIPT_URL_HERE" then return end
    local reexecCode = ("task.wait(3) loadstring(game:HttpGet('%s'))()"):format(SCRIPT_URL)
    
    if syn and syn.queue_on_teleport then
        syn.queue_on_teleport(reexecCode)
    elseif queue_on_teleport then
        queue_on_teleport(reexecCode)
    elseif fluxus and fluxus.queue_on_teleport then
        fluxus.queue_on_teleport(reexecCode)
    end
end

