    animating = true
    
    FloatingBtn.Visible = false
    Holder.Visible = true
    Main.Visible = true
    
    Main.Position = UDim2.new(0, 0, 0.05, 0)
    MainScale.Scale = 0.85
    
    local springInfo = TweenInfo.new(0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
    TweenService:Create(Main, springInfo, {Position = UDim2.new(0, 0, 0, 0)}):Play()
    TweenService:Create(MainScale, springInfo, {Scale = 1}):Play()
    
    task.delay(0.45, function() animating = false end)
    isOpen = true
end

local function closeWindow()
    if not isOpen or animating then return end
    animating = true
    
    local closeInfo = TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
    
    TweenService:Create(Main, closeInfo, {Position = UDim2.new(0, 0, 0.05, 0)}):Play()
    TweenService:Create(MainScale, closeInfo, {Scale = 0.85}):Play()
    
    task.delay(0.25, function()
        Main.Visible = false
        Holder.Visible = false
        FloatingBtn.Visible = true
        
        FBScale.Scale = 0.4
        TweenService:Create(FBScale, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = 1}):Play()
        animating = false
    end)
    isOpen = false
end

