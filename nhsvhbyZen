local function refresh(triggerHop)
    clearList()
    task.spawn(function()
        local servers = fetchAllServers()
        if #servers == 0 then 
            showToast("No joinable servers found.")
            return 
        end

        local zeros = {}
        for _, s in ipairs(servers) do
            if s.playing == 0 then table.insert(zeros, s) end
        end

        if #zeros > 0 then
            for i, s in ipairs(zeros) do addServerCard(i, s, true) end
        else
            for i = 1, math.min(#servers, 30) do addServerCard(i, servers[i], false) end
        end

        if triggerHop and #servers > 0 then
            task.wait(0.3)
            joinServer(servers[1].id, true, servers, 1)
        end
    end)
end

