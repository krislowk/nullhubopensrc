local function makeDraggable(target, onTap)
    target.InputBegan:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
        and input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end

        local startPos = input.Position
        local origin   = target.Position
        local moved    = 0
        local conn

        conn = input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.Change then
                local d = input.Position - startPos
                moved = math.max(moved, math.abs(d.X) + math.abs(d.Y))

                if moved >= 8 then
                    target.Position = UDim2.new(
                        origin.X.Scale, origin.X.Offset + d.X,
                        origin.Y.Scale, origin.Y.Offset + d.Y
                    )
                end
            elseif input.UserInputState == Enum.UserInputState.End then
                if conn then
                    conn:Disconnect()
                    conn = nil
                end
                if moved < 8 and onTap then
                    onTap()
                end
            end
        end)
    end)
end

local function setSpeed(alpha)
    alpha = math.clamp(alpha, 0, 1)
    speed = math.floor(10 + alpha * 490 + 0.5)
    fill.Size           = UDim2.new(alpha, 0, 1, 0)
    slideKnob.Position  = UDim2.new(alpha, 0, 0.5, 0)
    speedValue.Text     = tostring(speed)
end

slider.InputBegan:Connect(function(input)
    if input.UserInputType ~= Enum.UserInputType.MouseButton1
    and input.UserInputType ~= Enum.UserInputType.Touch then
        return
    end

    local function apply()
        local a = (input.Position.X - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1)
        setSpeed(a)
    end

    apply()

    local conn
    conn = input.Changed:Connect(function()
        if input.UserInputState == Enum.UserInputState.Change then
            apply()
        elseif input.UserInputState == Enum.UserInputState.End then
            if conn then
                conn:Disconnect()
                conn = nil
            end
        end
    end)
end)

