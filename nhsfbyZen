local function parts()
    local char = LP.Character
    if not char then return nil, nil, nil end
    return char, char:FindFirstChild("HumanoidRootPart"), char:FindFirstChildOfClass("Humanoid")
end

local function paint(on)
    TweenService:Create(switch, TweenInfo.new(0.16), {
        BackgroundColor3 = on and Color3.fromRGB(255, 255, 255) or TRACK_OFF,
    }):Play()

    TweenService:Create(knob, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Position         = on and UDim2.new(1, -18, 0.5, 0) or UDim2.new(0, 2, 0.5, 0),
        BackgroundColor3 = on and Color3.fromRGB(15, 15, 15) or MUTE,
    }):Play()

    TweenService:Create(statusDot, TweenInfo.new(0.16), {
        BackgroundColor3 = on and ACCENT or Color3.fromRGB(80, 80, 80),
    }):Play()
end

local function stop()
    flying = false

    if flyConn then flyConn:Disconnect() flyConn = nil end
    if bodyVelocity then bodyVelocity:Destroy() bodyVelocity = nil end
    if bodyGyro then bodyGyro:Destroy() bodyGyro = nil end

    local _, _, hum = parts()
    if hum then hum.PlatformStand = false end

    paint(false)
end

local function start()
    local _, hrp, hum = parts()
    if not hrp or not hum then return end

    stop()
    flying = true
    hum.PlatformStand = true

    bodyVelocity = new("BodyVelocity", {
        Name     = "NullHubFlyVel",
        MaxForce = Vector3.new(1e5, 1e5, 1e5),
        Velocity = Vector3.zero,
    }, hrp)

    bodyGyro = new("BodyGyro", {
        Name      = "NullHubFlyGyro",
        MaxTorque = Vector3.new(1e5, 1e5, 1e5),
        P         = 12000,
        D         = 140,
        CFrame    = hrp.CFrame,
    }, hrp)

    flyConn = RunService.RenderStepped:Connect(function()
        if not flying then return end

        local _, root, humanoid = parts()
        if not root or not humanoid or not bodyVelocity or not bodyGyro then
            stop()
            return
        end

        local cam = workspace.CurrentCamera
        if not cam then return end
        local camCF = cam.CFrame

        local fwd, strafe = 0, 0

        if controls then
            local ok, mv = pcall(function() return controls:GetMoveVector() end)
            if ok and mv then
                fwd    = -mv.Z
                strafe =  mv.X
            end
        else
            local md = humanoid.MoveDirection
            fwd    = md:Dot(camCF.LookVector)
            strafe = md:Dot(camCF.RightVector)
        end

        local lift = 0
        if UIS:IsKeyDown(Enum.KeyCode.Space) or (os.clock() - jumpStamp) < 0.14 then
            lift = 1
        elseif UIS:IsKeyDown(Enum.KeyCode.LeftShift) or UIS:IsKeyDown(Enum.KeyCode.LeftControl) then
            lift = -1
        end

        local dir = camCF.LookVector * fwd + camCF.RightVector * strafe
        if lift ~= 0 then
            dir = dir + Vector3.yAxis * lift
        end

        if dir.Magnitude > 0 then
            dir = dir.Unit * speed
        end

        bodyVelocity.Velocity = dir
        bodyGyro.CFrame       = camCF
    end)

    paint(true)
end

local panelOpen = false

local function openPanel()
    if panelOpen then return end
    panelOpen = true

    panel.Visible = true
    scale.Scale = 0.85

    TweenService:Create(scale, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Scale = 1
    }):Play()
end

local function closePanel()
    if not panelOpen then return end
    panelOpen = false

    local t = TweenService:Create(scale, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
        Scale = 0.85
    })
    t:Play()

    t.Completed:Connect(function()
        if not panelOpen then
            panel.Visible = false
        end
    end)
end

local function togglePanel()
    if panelOpen then closePanel() else openPanel() end
end

